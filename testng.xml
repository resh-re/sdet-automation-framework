<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SDET Automation Suite" parallel="methods" thread-count="3">
  <listeners>
    <listener class-name="base.TestListener"/>
  </listeners>

  <test name="Smoke Suite">
    <groups>
      <run>
        <include name="smoke"/>
      </run>
    </groups>
    <packages>
      <package name="tests.*"/>
    </packages>
  </test>
</suite>

